# Application Configuration
APP_PROJECT_NAME="Mutual Fund Discovery & Intelligence API"
APP_VERSION="1.0.0"
APP_ENVIRONMENT="development"
APP_DEBUG=false

# Upstream Service Configuration
APP_UPSTREAM_BASE_URL="https://groww.in"
APP_UPSTREAM_TIMEOUT_CONNECT=5.0
APP_UPSTREAM_TIMEOUT_READ=10.0
APP_UPSTREAM_TIMEOUT_WRITE=5.0
APP_UPSTREAM_TIMEOUT_POOL=5.0
APP_UPSTREAM_MAX_RETRIES=2
APP_UPSTREAM_BACKOFF_FACTOR=0.5

# In-Memory Cache Settings (TTL in seconds)
APP_CACHE_ENABLED=true
APP_CACHE_SEARCH_TTL=900
APP_CACHE_EXPLORE_TTL=1800
APP_CACHE_DETAIL_TTL=7200
APP_CACHE_CATEGORIES_TTL=86400
APP_CACHE_MAX_ITEMS=2048
